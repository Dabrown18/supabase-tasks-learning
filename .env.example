# Copy this file to `.env` and fill in the values from:
#   Supabase Dashboard → your project → Project Settings → API Keys / Data API
#
# Anything prefixed EXPO_PUBLIC_ is inlined into the app bundle and is PUBLIC.
# Only these two values belong here. They are safe to expose because Row Level
# Security in Postgres decides what each user can access.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# ---------------------------------------------------------------------------
# NEVER put these in this file or anywhere in the React Native app:
#   - Secret key (sb_secret_...) / legacy service_role key  → bypasses RLS
#   - Database password or connection string
#   - Google OAuth client secret, LLM API keys, etc.
# Server-side secrets go into Edge Function secrets instead:
#   npx supabase secrets set GOOGLE_CLIENT_SECRET=...
# ---------------------------------------------------------------------------
